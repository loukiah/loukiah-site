<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seoTitle or title or (site.name + " — Film director & portrait photographer in Berlin") }}</title>
<meta name="description" content="{{ seoDescription or description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" sizes="32x32" href="/media/brand/favicon-32.png">
<link rel="apple-touch-icon" href="/media/brand/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ seoTitle or title or (site.name + ' — Film director & photographer') }}">
<meta property="og:description" content="{{ seoDescription or description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/media/brand/share-2.jpg' }}">
{% if not ogImage %}<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/assets/fonts/instrument-sans-latin-wdth-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css?v={{ build }}">
{% include "schema.njk" %}
<script>window.vfb=function(v){try{if(!/^((?!chrome|chromium|android|crios|fxios|edg).)*safari/i.test(navigator.userAgent))return;var im=v.previousElementSibling;if(im&&im.tagName==="PICTURE")im=im.querySelector("img");if(!im||im.tagName!=="IMG"||im.dataset.fb)return;var tall=matchMedia("(orientation: portrait) and (max-width: 900px)").matches;var s=(tall&&v.dataset.v)||v.dataset.sd||v.getAttribute("src")||v.currentSrc;if(!s)return;im.dataset.fb="1";if(im.parentElement.tagName==="PICTURE")[].slice.call(im.parentElement.querySelectorAll("source")).forEach(function(x){x.remove()});im.src=s;}catch(e){}};</script>
<script>document.addEventListener("timeupdate",function(e){var v=e.target;if(v.tagName==="VIDEO"&&!v.paused&&v.currentTime>0.05)v.classList.add("on")},true);document.addEventListener("pause",function(e){if(e.target.tagName==="VIDEO")e.target.classList.remove("on")},true)</script>
</head>
<body{% if section == "contact" %} class="contactpg"{% endif %}>
<div class="wrap">
{% if not cover %}{% include "header.njk" %}{% endif %}
{{ content | safe }}
{% if not cover %}{% include "footer.njk" %}{% endif %}
{% include "menu.njk" %}
</div>
<script src="/assets/site.js?v={{ build }}" defer></script>
</body>
</html>
